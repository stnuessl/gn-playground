import("//gn/python/python.gni")

template("bundle") {
  python(target_name) {
    _vars = [
      "testonly",
      "visibility",
    ]

    forward_variables_from(invoker, "*", _vars)
    forward_variables_from(invoker, _vars)

    metadata = {
      template = [ "bundle" ]
    }

    if (!defined(outputs)) {
      outputs = [ "$target_gen_dir/$target_name.ack" ]
    }

    script = "//gn/python/scripts/touch.py"
    args = [ rebase_path(outputs[0], root_build_dir) ]
  }
}
