import("//gn/python/python.gni")
import("//gn/vars.gni")

template("depfile") {
  python(target_name) {
    _vars = [
      "testonly",
      "visibility",
    ]
    _ignore = _vars + [
                "exclude",
                "include",
                "labels",
              ]

    forward_variables_from(invoker, "*", _ignore)
    forward_variables_from(invoker, _vars)

    testonly = true

    if (!defined(deps)) {
      deps = []
    }

    if (!defined(inputs)) {
      inputs = []
    }

    env =
        [ "PYTHONPATH=" + rebase_path("//gn/python/packages", root_build_dir) ]
    deps += [ description_target ]
    inputs += description_outputs

    if (!defined(depfile)) {
      depfile = "$target_gen_dir/$target_name.d"
    }

    if (!defined(outputs)) {
      outputs = [ depfile ]
    }

    script = "//gn/depfile/make-depfile.py"
    args = [
      "--description",
      rebase_path(description_outputs[0], root_build_dir),
      "--depfile",
      rebase_path(depfile, root_build_dir),
    ]

    if (outputs[0] != depfile) {
      args += [
        "-o",
        rebase_path(outputs[0], root_build_dir),
      ]
    }

    if (defined(invoker.include)) {
      args += [ "--include" ]
      args += invoker.include
    }

    if (defined(invoker.exclude)) {
      args += [ "--exclude" ]
      args += invoker.exclude
    }

    args += [ "--" ]

    if (invoker.labels == [ "//*" ]) {
      args += [ "//*" ]
    } else {
      foreach(_item, invoker.labels) {
        args += [ get_label_info(_item, "label_no_toolchain") ]
      }
    }
  }
}
