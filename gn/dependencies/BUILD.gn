import("//gn/depfile/depfile.gni")
import("//gn/python/python.gni")
import("//gn/toolchains/clang/vars.gni")
import("//gn/vars.gni")

#
# We could also use ninja to retrieve the dependencies which would actually be
# faster. However, on Windows we seem to run into a lot of race conditions
# due to parallel file accesses. The slower but more robust solution seems to
# be clang-scan-deps.
#
# We generate an extra dependency file to cope with a potentially large
# execution time of clang-scan-deps

depfile("depfile") {
  # Likely "../"
  _root_dir = rebase_path("//", root_build_dir)

  # Get the name of the build directory
  _build_dir = rebase_path(root_build_dir, "//")

  # clang-scan-deps will scan all files contained in the compilation
  # database.
  labels = [ "//gn/compile-commands" ]

  exclude = [
    # Exclude all generated files.
    string_replace("$_root_dir/$_build_dir/*", "//", "/"),
  ]
}

action("clang-scan-deps") {
  testonly = true
  deps = [ ":depfile" ]
  inputs = get_target_outputs(":depfile")
  outputs = [ "$target_gen_dir/dependencies-raw.json" ]
  pool = "//:console"

  script = clang_scan_deps_tool
  args = [
    "-compilation-database",
    rebase_path("$root_build_dir/compile_commands.json", root_build_dir),
    "-mode",
    "preprocess-dependency-directives",
    "-format",
    "experimental-full",
    "-o",
    rebase_path(outputs[0], root_build_dir),
  ]
}

# Transform data format of deps to decouple our scripts from the
# experimental output of clang-scan-deps.
python("dependencies") {
  testonly = true
  deps = [ ":clang-scan-deps" ]
  inputs = get_target_outputs(":clang-scan-deps")
  outputs = dependencies_outputs
  mnemonic = "DEPS"

  env = [ "PYTHONPATH=" + rebase_path("//gn/python/packages", root_build_dir) ]
  script = "//gn/dependencies/transform-dependencies.py"
  args = [
    rebase_path(inputs[0], root_build_dir),
    "-o",
    rebase_path(dependencies_outputs[0], root_build_dir),
    "--vfs-config",
    rebase_path(clang.vfs_config_path, root_build_dir),
    "--exclude-deps",
    "*/vfs.json",
    "/include/*",
    "/lib/*",
    "/usr/include/*",
    "/usr/lib/*",
  ]
}
